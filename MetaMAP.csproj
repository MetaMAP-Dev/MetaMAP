<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net8.0 (no -windows suffix, no UseWindowsForms) builds one cross-platform
             assembly Rhino 8 loads on both Windows and Mac. Rhino 8 hosts plug-ins on .NET 8:
             its dotnetstart.8.runtimeconfig.json asks for Microsoft.NETCore.App 8.0.0 with
             rollForward LatestMinor. That rolls forward within 8.x only, so net9.0 would not
             load - see the Grasshopper reference below for the minimum-version consequence. -->
        <TargetFrameworks>net8.0</TargetFrameworks>
        <Title>MetaMAP</Title>
        <Company>Ilker Karadag</Company>
        <Description>MetaMAP component for advanced mapping and analysis.</Description>
        <PackageProjectUrl>https://archidynamics.com/</PackageProjectUrl>
        <Keyword1>metamap</Keyword1>
        <Keyword2>mapping</Keyword2>
        <Keyword3>analysis</Keyword3>
        <NeutralLanguage>en-US</NeutralLanguage>
        <PackageIcon>Resources\MetaBuilding.png</PackageIcon>
        <LangVersion>12</LangVersion>
        <RootNamespace>MetaMAP</RootNamespace>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
        <!-- Only the assemblies listed in the Distribution target are shipped. Rhino 8 already
             provides RhinoCommon, Grasshopper, Eto, System.Drawing and System.Windows.Forms on
             both platforms; shipping our own copies next to the .gha breaks loading on macOS
             ("Ribbon could not be populated", Eto windows failing to open). -->
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <!-- Rhino / Grasshopper API (compile-time only; Rhino supplies them at runtime).
             The Yak package inherits its minimum Rhino version from this reference, so this pin
             is the plug-in's compatibility floor.

             8.27 is not a preference, it is the lowest version that works. Rhino 8.19 and older
             host plug-ins on .NET 7 and cannot load a net8.0 assembly at all, so the floor could
             not be below 8.20 regardless. Of the stable packages above that (8.21, 8.23, 8.24,
             8.25, 8.26) every one fails this build with NETSDK1073 - their targets pull a
             WindowsDesktop FrameworkReference that does not resolve for a plain net8.0 build on
             macOS. Setting EnableWindowsTargeting=true makes them build, but it also drags
             System.Drawing.Common and System.Windows.Forms up to 8.0.0.0, which is exactly the
             runtime mismatch the reference below exists to avoid. 8.27 builds without the flag
             and emits 7.0.0.0. -->
        <PackageReference Include="Grasshopper" Version="8.27.26019.16021" IncludeAssets="compile;build" />
        <!-- System.Drawing types used by the Grasshopper API (icons, canvas rendering). Compile-time
             only: Rhino ships its own System.Drawing.Common on both platforms. -->
        <!-- 7.0.0, NOT 8.0.0, even though this assembly targets net8.0. Rhino 8.32 ships
             System.Drawing.Common at assembly version 7.0.0.0 and RhinoCommon itself references
             7.0.0.0; .NET binds forward only, so a reference to 8.0.0.0 cannot be satisfied at
             runtime and the .gha fails to load. Same pin Eddy3D uses on net8.0. -->
        <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" />
        <!-- Shipped next to the .gha (see Distribution target). -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup>
        <!-- The Rhino-free half. Shipped next to the .gha by the Distribution target. -->
        <ProjectReference Include="MetaMAP.Core\MetaMAP.Core.csproj" />
    </ItemGroup>

    <!-- GH_Component's menu API (AppendAdditionalComponentMenuItems) is typed against
         System.Windows.Forms regardless of platform. Reference the compile-time-only reference
         assemblies; at runtime Rhino/Grasshopper itself supplies the real implementation on both
         Windows and Mac. See https://discourse.mcneel.com/t/windows-forms-on-gh-and-rhino-8/171307
         The 7.0 reference assemblies are deliberate on a net8.0 target: Rhino ships
         System.Windows.Forms at assembly version 7.0.0.0, and a reference to 8.0.0.0 would not
         bind at runtime. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsDesktop.App.Ref" Version="7.0.0" GeneratePathProperty="true" ExcludeAssets="all" />
        <Reference Include="$(PkgMicrosoft_WindowsDesktop_App_Ref)\ref\net7.0\System.Windows.Forms.dll" Private="false" />
    </ItemGroup>

    <!-- Icons, Leaflet script and stylesheet are plain manifest resources (see src/MetaResources.cs). -->
    <ItemGroup>
        <!-- Both live under this project's directory, so the SDK's **/*.cs glob would compile
             them into the .gha as well and every Core type would exist twice. -->
        <Compile Remove="tests\**\*.cs" />
        <Compile Remove="MetaMAP.Core\**\*.cs" />
        <EmbeddedResource Include="Resources\*.png;Resources\leaflet.css;Resources\leaflet.js" LogicalName="MetaMAP.Resources.%(Filename)%(Extension)" />
        <None Include="Templates\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>Templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

    <Target Name="WriteVersionToFile" BeforeTargets="BeforeBuild">
        <WriteLinesToFile File="version.txt" Lines="$(Version)" Overwrite="true" />
    </Target>

    <Target Name="CopyVersionToOutput" AfterTargets="WriteVersionToFile">
        <Copy SourceFiles="version.txt" DestinationFiles="$(TargetDir)version.txt" />
    </Target>

    <Target Name="CopyAndRenameDll" AfterTargets="AfterBuild">
        <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFiles="$(TargetDir)$(TargetName).gha" />
        <Copy SourceFiles="$(PkgNewtonsoft_Json)\lib\net6.0\Newtonsoft.Json.dll" DestinationFolder="$(TargetDir)" />
    </Target>

    <!-- Assemble the clean folder that "yak build" packages. -->
    <Target Name="Distribution" AfterTargets="CopyAndRenameDll" DependsOnTargets="CopyVersionToOutput">
        <!-- Evaluated here (not at project level) because $(TargetDir) is only known once the SDK targets ran. -->
        <PropertyGroup>
            <DistDir>$(TargetDir)dist$([System.IO.Path]::DirectorySeparatorChar)</DistDir>
        </PropertyGroup>
        <ItemGroup>
            <DistTemplates Include="$(MSBuildProjectDirectory)\Templates\**\*.gh*" />
        </ItemGroup>
        <RemoveDir Directories="$(DistDir)" />
        <MakeDir Directories="$(DistDir)" />
        <!-- LICENSE.md ships with the binary: GPLv3 section 4 requires the license to accompany
             every conveyed copy, and the Yak package is how users receive one. -->
        <Copy SourceFiles="$(TargetDir)$(TargetName).gha;$(TargetDir)MetaMAP.Core.dll;$(TargetDir)Newtonsoft.Json.dll;$(TargetDir)version.txt;$(MSBuildProjectDirectory)\manifest.yml;$(MSBuildProjectDirectory)\LICENSE.md" DestinationFolder="$(DistDir)" />
        <!-- manifest.yml points at this icon; the package manager shows it in the plug-in list. -->
        <Copy SourceFiles="$(MSBuildProjectDirectory)\Resources\MetaBuilding.png" DestinationFolder="$(DistDir)Resources" />
        <Copy SourceFiles="@(DistTemplates)" DestinationFiles="@(DistTemplates->'$(DistDir)Templates\%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>

    <!-- Local development: write MetaMAP.ghlink into the Grasshopper Libraries folder so Rhino
         loads the freshly built plug-in straight from the dist folder. One file, overwritten on
         every build, so it always points at whichever configuration was built last.
         Skipped when no Grasshopper Libraries folder exists (CI). -->
    <Target Name="WriteGrasshopperLink" AfterTargets="Distribution">
        <PropertyGroup>
            <GhLibrariesDir Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/Plug-ins/Grasshopper (b45a29b1-4343-4035-989e-044e8580d9cf)/Libraries</GhLibrariesDir>
            <GhLibrariesDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(APPDATA)\Grasshopper\Libraries</GhLibrariesDir>
            <GhLinkFile>$(GhLibrariesDir)$([System.IO.Path]::DirectorySeparatorChar)$(TargetName).ghlink</GhLinkFile>
            <GhLinkTarget>$(DistDir.TrimEnd('/').TrimEnd('\'))</GhLinkTarget>
        </PropertyGroup>
        <WriteLinesToFile File="$(GhLinkFile)" Lines="$(GhLinkTarget)" Overwrite="true" Condition="'$(GhLibrariesDir)' != '' And Exists('$(GhLibrariesDir)')" />
        <Message Importance="high" Text="Grasshopper link: $(GhLinkFile) -> $(GhLinkTarget)" Condition="'$(GhLibrariesDir)' != '' And Exists('$(GhLibrariesDir)')" />
    </Target>

</Project>
